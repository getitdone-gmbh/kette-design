{
  "name": "@getitdone-gmbh/ui",
  "version": "0.1.0",
  "description": "Free React primitives of the Get IT Done design system for complex software. shadcn/ui and Radix UI based, Tailwind CSS, TypeScript, light and dark theme included.",
  "license": "MIT",
  "author": "Get IT Done GmbH",
  "homepage": "https://zero-design.itdone.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getitdone-gmbh/ui.git"
  },
  "bugs": {
    "url": "https://github.com/getitdone-gmbh/ui/issues"
  },
  "keywords": [
    "react",
    "shadcn",
    "shadcn-ui",
    "radix-ui",
    "tailwindcss",
    "design-system",
    "components",
    "typescript",
    "enterprise",
    "complex-software"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./styles/theme.css",
    "./animation.css": "./styles/animation.css",
    "./styles.css": "./dist/styles.css",
    "./tailwind/preset": "./tailwind/preset.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "tailwind",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "rimraf dist && vite build && tailwindcss -c tailwind.config.cjs -i styles/build.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "registry:build": "node scripts/build-registry.mjs && shadcn build -o public/r"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^3.3.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^2.30.0",
    "embla-carousel-react": "^8.5.1",
    "lucide-react": "^0.379.0",
    "react-day-picker": "^8.9.1",
    "react-hook-form": "^7.47.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-themer": "^3.1.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "postcss-import": "^16.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "rollup-plugin-preserve-directives": "^0.2.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.12",
    "vite-plugin-dts": "^3.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
