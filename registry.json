{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "getitdone",
  "homepage": "https://zero-design.itdone.de",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "zero theme",
      "description": "CSS variables (light and dark), animations and the Tailwind CSS 3 preset of the Get IT Done design system. Import styles/getitdone/theme.css and animation.css in your global CSS and add tailwind/getitdone/preset.cjs to presets.",
      "dependencies": [
        "tailwindcss-animate",
        "tailwindcss-themer",
        "@tailwindcss/container-queries"
      ],
      "files": [
        {
          "path": "registry/theme/theme.css",
          "type": "registry:file",
          "target": "styles/getitdone/theme.css"
        },
        {
          "path": "registry/theme/animation.css",
          "type": "registry:file",
          "target": "styles/getitdone/animation.css"
        },
        {
          "path": "registry/theme/preset.cjs",
          "type": "registry:file",
          "target": "tailwind/getitdone/preset.cjs"
        },
        {
          "path": "registry/theme/tailwind.preset.cjs",
          "type": "registry:file",
          "target": "tailwind/getitdone/tailwind.preset.cjs"
        },
        {
          "path": "registry/theme/tailwind.theme.cjs",
